# ==========================================
# .dockerignore - Frontend Next.js
# ==========================================

# Dependencias (se instalan dentro del contenedor)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
yarn.lock

# Next.js build outputs (se construyen dentro del contenedor)
.next/
out/
build/
dist/

# Archivos de desarrollo
.env
.env.*
.env.local
.env.development
.env.test
.env.production
*.env

# Control de versiones
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
logs/
*.log

# Testing y coverage
coverage/
.nyc_output/
__tests__/
*.spec.ts
*.test.ts
*.spec.tsx
*.test.tsx

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Documentación
README.md
docs/
*.md

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo

# Archivos temporales
.tmp/
temp/